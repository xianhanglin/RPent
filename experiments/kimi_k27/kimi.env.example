# Copy to ~/.config/rpent/kimi.env and `chmod 600` it. Never commit the real file.
# Fill in ONE of the two blocks below.

# --- Option A: self-hosted vLLM (Anthropic /v1/messages served by vLLM itself) ---
# Base URL without /v1; Claude Code appends /v1/messages. vLLM's --api-key only
# checks "Authorization: Bearer", so bearer mode is required when it is set.
KIMI_BACKEND=vllm
MOONSHOT_ANTHROPIC_BASE_URL=http://REMOTE_HOST:8000
MOONSHOT_API_KEY=the-value-passed-to-vllm---api-key
MOONSHOT_AUTH_MODE=bearer

# --- Option B: Moonshot official API ---
# Keys are platform-specific: a platform.moonshot.cn key only works with
# api.moonshot.cn, a platform.kimi.ai key only with api.moonshot.ai.
# KIMI_BACKEND=api
# MOONSHOT_ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MOONSHOT_API_KEY=sk-REPLACE_ME
# Claude Code sends ANTHROPIC_API_KEY as x-api-key; switch to "bearer" if
# rpent-check-llm reports auth_failed.
# MOONSHOT_AUTH_MODE=x-api-key
